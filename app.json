{
  "expo": {
    "name": "Shotra",
    "slug": "shotra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "shotra",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cyclonet.shotra",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shotra necesita tu ubicacion para encontrar servicios cerca de ti.",
        "NSLocationAlwaysUsageDescription": "Shotra usa tu ubicacion para notificarte solicitudes cercanas.",
        "NSCameraUsageDescription": "Shotra necesita acceso a la camara para tu foto de perfil y portafolio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.cyclonet.shotra",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-notifications",
      "expo-secure-store",
      "expo-image-picker",
      "expo-asset",
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4007e7fb-6707-4b22-96ff-9ac0aadb4dab",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4007e7fb-6707-4b22-96ff-9ac0aadb4dab"
      }
    },
    "owner": "cyclonet-s-a-s"
  }
}
