{
  "expo": {
    "name": "Shotra",
    "slug": "shotra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "shotra",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cyclonet.shotra",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shotra necesita tu ubicacion para encontrar servicios cerca de ti.",
        "NSLocationAlwaysUsageDescription": "Shotra usa tu ubicacion para notificarte solicitudes cercanas.",
        "NSCameraUsageDescription": "Shotra necesita acceso a la camara para tu foto de perfil y portafolio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.cyclonet.shotra",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-notifications",
      "expo-secure-store",
      "expo-image-picker"
    ]
  }
}
